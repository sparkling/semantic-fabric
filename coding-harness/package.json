{
  "name": "coding-harness",
  "version": "0.1.0",
  "description": "Harness for semantic-fabric",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/sync-harness-manifest.mjs && node scripts/harden-build.mjs",
    "test": "vitest run",
    "delivery": "node dist/delivery-cli.js",
    "postgres-observation-qualification": "node dist/postgres-observation-qualification-cli.js",
    "prepublishOnly": "node scripts/deny-publish.mjs"
  },
  "dependencies": {
    "@metaharness/harness": "latest",
    "@metaharness/host-claude-code": "latest",
    "@metaharness/host-codex": "latest",
    "@metaharness/router": "latest"
  },
  "devDependencies": {
    "@claude-flow/cli": "latest",
    "@types/node": "24",
    "metaharness": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
